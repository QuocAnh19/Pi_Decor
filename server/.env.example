# Copy this file to .env and fill in real values before running the server.

PORT=4000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Used to sign admin JWTs. Generate a real random string for production,
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Database ---
# Leave unset -> the app falls back to a JSON file at src/data/db.json
# (zero setup, fine for a quick local clone, NOT for production).
#
# Set this to switch the whole app to Postgres (see database/README.md):
#   1. Create a free Postgres database — Neon (neon.tech) or a Supabase
#      project (supabase.com) both work; so does a local Docker container.
#   2. Copy its connection string here.
#   3. Run `npm run migrate` once to create all tables.
#   4. Run `npm run seed` once to create the admin account + starter data.
#
# Neon example  (note ?sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/pidecor?sslmode=require
#
# Supabase example (use the "Connection pooling" string for serverless/
# Render deploys, the direct "Connection string" for local dev):
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# SECURITY (see database/SECURITY.md §1): the string above should be the
# migration/"owner" role only while running `npm run migrate` locally.
# The DEPLOYED server should use a separate, low-privilege
# `pidecor_app` role instead (created via
# database/security/create_app_role.sql) — set that role's connection
# string as DATABASE_URL in your hosting platform's env vars (Render/
# Vercel dashboard), never the owner string.
DATABASE_URL=

DB_POOL_MAX=10

# Ảnh (Cloudinary Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
