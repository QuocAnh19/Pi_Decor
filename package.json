{
  "name": "pi-decor-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build:shared": "npm --workspace=@pidecor/shared run build",
    "build:web": "npm --prefix apps/web run build",
    "test:web": "npm --prefix apps/web run test",
    "test:api": "npm --prefix apps/api run test",
    "test:coverage": "npm --prefix apps/web run test:coverage && npm --prefix apps/api run test:coverage",
    "lint:web": "npm --prefix apps/web run lint",
    "lint:api": "npm --prefix apps/api run lint",
    "verify:web": "npm run build:shared && npm --prefix apps/web run verify",
    "verify:api": "npm run build:shared && npm --prefix apps/api run verify",
    "verify": "npm run verify:web && npm run verify:api",
    "e2e": "playwright test",
    "e2e:update": "playwright test -u",
    "launch:check": "node scripts/check-launch-readiness.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:licenses": "node scripts/check-licenses.mjs",
    "sbom": "npx @cyclonedx/cyclonedx-npm --ignore-npm-errors --output-format JSON --output-file bom.json"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  }
}
