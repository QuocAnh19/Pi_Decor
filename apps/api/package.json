{
  "name": "pi-decor-server",
  "private": true,
  "license": "UNLICENSED",
  "author": "<TÊN CHỦ SỞ HỮU>",
  "version": "1.0.0",
  "type": "module",
  "description": "Pi Decor REST API — leads, saved designs, materials & a minimal admin area. See README.md.",
  "scripts": {
    "predev": "npm run build:shared --prefix ../..",
    "dev": "node --watch src/server.js",
    "prestart": "npm run build:shared --prefix ../..",
    "start": "node src/server.js",
    "migrate": "node database/migrate.js",
    "migrate:adopt-baseline": "node scripts/adopt-baseline.js",
    "seed": "node src/utils/seed.js",
    "cleanup-tokens": "node scripts/cleanup-tokens.js",
    "purge-leads": "node scripts/purge-leads.js",
    "media:audit": "node scripts/media-audit.js",
    "docs:db": "node scripts/gen-db-docs.js",
    "lint": "eslint src",
    "check:syntax": "node ../../scripts/check-syntax.mjs src",
    "check:db-env": "node ../../scripts/check-db-env.mjs",
    "pretest": "npm run build:shared --prefix ../..",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check:db-env && npm run lint && npm run check:syntax && npm run migrate && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pidecor/shared": "*",
    "@sentry/node": "^11.8.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^3.19.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
