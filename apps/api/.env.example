# Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy server.

# Môi trường chạy: development | test | production (mặc định development)
NODE_ENV=development

# Cổng lắng nghe của API (mặc định 4000)
PORT=4000

# Danh sách Origin được phép truy cập CORS, cách nhau bởi dấu phẩy
CORS_ORIGIN=http://localhost:5173

# Trust proxy: 1 khi đứng sau reverse proxy (Render, Railway, Nginx) ở production, 0 khi dev
TRUST_PROXY=0

# BẮT BUỘC: Khóa bí mật ký JWT (tối thiểu 32 ký tự)
# Lệnh tạo chuỗi ngẫu nhiên an toàn:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Thời hạn hiệu lực của access token (mặc định 15m)
JWT_EXPIRES_IN=15m

# --- Database (PostgreSQL) ---
# BẮT BUỘC cấu hình chuỗi kết nối PostgreSQL (xem docs/RUNBOOK.md):
#   - Local Docker: postgresql://pidecor:pidecor_dev_only@localhost:5432/pidecor
#   - Neon Pooled (cho API runtime qua PgBouncer transaction mode):
#     postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/pidecor?sslmode=verify-full
#   - Neon Direct (cho migrate, seed, admin scripts, backup/restore):
#     postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/pidecor?sslmode=verify-full
#   Lưu ý pg v9 & pg-connection-string v3:
#     - Mặc định an toàn cao nhất: dùng ?sslmode=verify-full (rejectUnauthorized: true, chống MITM).
#     - Nếu cần tương thích libpq: dùng ?uselibpqcompat=true&sslmode=require.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Giới hạn số kết nối tối đa trong connection pool (mặc định 5 cho Neon free tier)
DB_POOL_MAX=5

# Chế độ SSL cho kết nối PostgreSQL: disable | require | verify-full (mặc định verify-full ngoài localhost)
DB_SSL=verify-full
# Đường dẫn file chứng chỉ CA hoặc nội dung PEM (nếu môi trường thiếu ISRG Root X1)
DB_SSL_CA=

# --- Ảnh (Cloudinary Storage) ---
# Bắt buộc khi NODE_ENV=production. Ở dev nếu để trống sẽ lưu file cục bộ vào thư mục uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Tiền tố thư mục Cloudinary (mặc định 'pidecor/dev' ở dev/test; bắt buộc ở production, ví dụ: 'pidecor/prod')
CLOUDINARY_FOLDER_PREFIX=pidecor/dev

# --- Tài khoản Admin (bắt buộc khi chạy npm run seed) ---
ADMIN_EMAIL=admin@pidecor.vn
# BẮT BUỘC tối thiểu 12 ký tự
ADMIN_PASSWORD=

# --- Giám sát lỗi (Sentry — Tùy chọn) ---
# Điền DSN từ dự án Sentry nếu muốn bật tính năng ghi nhận lỗi tập trung
SENTRY_DSN=

# --- Chính sách lưu trữ dữ liệu (Data Retention) ---
# Thời gian lưu trữ tối đa đối với dữ liệu leads (ngày, mặc định 180 ngày)
RETENTION_DAYS=180


