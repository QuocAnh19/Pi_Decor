# URL của API backend
VITE_API_URL=http://localhost:4000/api

# Sentry DSN cho giám sát lỗi client (tùy chọn)
VITE_SENTRY_DSN=

# --- Thông tin doanh nghiệp (để trống nếu chưa có thông tin chính thức; để trống sẽ ẩn khỏi giao diện) ---
# Tên thương hiệu / pháp nhân
VITE_BUSINESS_NAME=
# Số điện thoại liên hệ (VD: +84 789 241 260 hoặc 0789241260)
VITE_BUSINESS_TELEPHONE=
# Email liên hệ chung (VD: contact@pidecor.vn)
VITE_BUSINESS_EMAIL=
# Địa chỉ trụ sở (VD: 372 Trần Đại Nghĩa)
VITE_BUSINESS_STREET_ADDRESS=
# Phường / Xã / Quận (VD: Hòa Hải, Ngũ Hành Sơn)
VITE_BUSINESS_LOCALITY=
# Tỉnh / Thành phố (VD: Đà Nẵng)
VITE_BUSINESS_REGION=
# Mã bưu chính (VD: 550000)
VITE_BUSINESS_POSTAL_CODE=
# Mã quốc gia 2 ký tự (VD: VN)
VITE_BUSINESS_COUNTRY=
# Tọa độ địa lý vĩ độ (latitude, VD: 15.9753)
VITE_BUSINESS_LATITUDE=
# Tọa độ địa lý kinh độ (longitude, VD: 108.2532)
VITE_BUSINESS_LONGITUDE=
# Khung giờ làm việc (VD: Mo-Su 08:00-20:00)
VITE_BUSINESS_OPENING_HOURS=
# Email tiếp nhận yêu cầu bảo vệ dữ liệu cá nhân (VD: privacy@pidecor.vn)
VITE_BUSINESS_DATA_PROTECTION_EMAIL=

# Thời hạn lưu trữ dữ liệu leads theo số ngày (VD: 180)
VITE_RETENTION_DAYS=

# Xác nhận Chính sách bảo mật đã được bộ phận pháp lý rà soát (true/false)
VITE_PRIVACY_POLICY_REVIEWED=false

