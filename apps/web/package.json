{
  "name": "pi-decor-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:shared --prefix ../..",
    "dev": "vite",
    "prebuild": "npm run build:shared --prefix ../..",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "preview": "vite preview",
    "knip": "knip",
    "pretest": "npm run build:shared --prefix ../..",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run lint:styles && npm run knip && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@pidecor/shared": "*",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.104.3",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "postcss": "^8.4.38",
    "sass": "^1.77.6",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  }
}
